# ==============================================================================
# AI Investment Due Diligence Copilot - Environment Configuration
# ==============================================================================

# Core Project Settings
PROJECT_NAME="AI Investment Due Diligence Copilot"
VERSION="1.0.0"
ENVIRONMENT="production"  # production, staging, development
PORT=8000

# LLM Gateway Provider Configuration
# Supported providers: "gemini", "openai", "mock"
# If no keys are provided, the system automatically falls back to the deterministic Mock adapter.
LLM_PROVIDER=gemini
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Database Configuration
# Default: Local persistent SQLite database
# Production (AWS RDS / PostgreSQL): postgresql+asyncpg://user:password@host:5432/diligence_db
DATABASE_URL="sqlite+aiosqlite:///./diligence_copilot.db"

# Storage Configuration
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=50

# Worker & Queue Settings
QUEUE_BACKEND="sqlite"  # sqlite, memory, postgres
CONCURRENCY_WORKERS=2
